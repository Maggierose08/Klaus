FROM python:3.12-slim

WORKDIR /app

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY trading/ trading/

# Default entrypoint runs the market-open pipeline. The daily-summary Cloud
# Run Job reuses this same image with its command overridden at deploy time
# (see trading/DEPLOY.md), so there's only one image to build and push.
CMD ["python", "-m", "trading.pipeline"]
